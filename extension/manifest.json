{
  "manifest_version": 3,
  "name": "Send to TubeStreamer",
  "version": "1.0.0",
  "description": "One click to queue the current video (or any link) on your TubeStreamer server.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Send to TubeStreamer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Send the current tab to TubeStreamer"
    }
  }
}
